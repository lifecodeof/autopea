{
  "name": "autopea-monorepo-root",
  "private": true,
  "scripts": {
    "build": "pnpm run --filter !tests -r build",
    "publish": "pnpm typecheck && pnpm lint && pnpm publish --filter !tests -r --no-git-checks",
    "typecheck": "pnpm run build && pnpm --parallel -r exec tsc --noEmit",
    "fix": "biome check --fix",
    "lint": "biome lint"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc",
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  }
}
