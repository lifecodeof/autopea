{
  "name": "autopea-monorepo-root",
  "private": true,
  "scripts": {
    "build": "pnpm run --filter !tests -r build",
    "publish": "pnpm typecheck && pnpm lint && pnpm publish --filter !tests -r --no-git-checks",
    "typecheck": "pnpm run build && pnpm --parallel -r exec tsc --noEmit",
    "fix": "biome check --fix",
    "lint": "biome lint",
    "test": "pnpm --filter ./packages/tests run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
