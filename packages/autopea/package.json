{
  "name": "@lifecodeof/autopea",
  "version": "1.1.4",
  "description": "Library for automating Photopea",
  "scripts": {
    "start": "tsx main.ts",
    "repl": "tsx src/repl.ts",
    "test": "vitest",
    "build": "tsdown"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "lifecodeof",
  "type": "module",
  "dependencies": {
    "async-mutex": "^0.5.0",
    "nanoevents": "^9.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "^25.2.1",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.mts",
      "default": "./dist/contracts/*.mjs"
    }
  }
