{
  "name": "autopea",
  "version": "3.3.2",
  "description": "Library for automating Photopea",
  "type": "module",
  "scripts": {
    "start": "tsx main.ts",
    "build": "tsdown"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "async-mutex": "catalog:",
    "nanoevents": "catalog:",
    "zod": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.mts",
      "default": "./dist/contracts/*.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifecodeof/autopea",
    "directory": "packages/autopea"
  },
  "bugs": {
    "url": "https://github.com/lifecodeof/autopea/issues"
  },
  "author": "lifecodeof",
  "license": "MIT",
  "keywords": [
    "autopea",
    "photopea",
    "automation",
    "image-editing",
    "psd",
    "photoshop-scripting",
    "extendscript"
  ]
}
