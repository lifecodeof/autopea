{
  "name": "autopea",
  "version": "3.3.1",
  "description": "Library for automating Photopea",
  "scripts": {
    "start": "tsx main.ts",
    "build": "tsdown"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "lifecodeof",
  "type": "module",
  "dependencies": {
    "async-mutex": "catalog:",
    "nanoevents": "catalog:",
    "zod": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.mts",
      "default": "./dist/contracts/*.mjs"
    }
  }
}
