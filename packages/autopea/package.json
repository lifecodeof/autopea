{
  "name": "@lifecodeof/autopea",
  "version": "1.0.0",
  "description": "Library for automating Photopea",
  "scripts": {
    "start": "tsx main.ts",
    "build": "tsdown"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "lifecodeof",
  "type": "module",
  "dependencies": {
    "async-mutex": "catalog:",
    "nanoevents": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.mts",
      "default": "./dist/contracts/*.mjs"
    }
  }
}
