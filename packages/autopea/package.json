{
  "name": "@lifecodeof/autopea",
  "version": "3.2.2",
  "description": "Library for automating Photopea",
  "scripts": {
    "start": "tsx main.ts",
    "build": "tsdown"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "lifecodeof",
  "type": "module",
  "dependencies": {
    "async-mutex": "catalog:",
    "nanoevents": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.mts",
      "default": "./dist/contracts/*.mjs"
    }
  }
}
