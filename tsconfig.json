{
  "compilerOptions": {
    "baseUrl": "./src",

    "paths": {
      "@/*": ["*"]
    },

    "types": ["node"],

    "strict": true,
    "noImplicitOverride": true,

    "target": "esnext",
    "moduleDetection": "force",
    "module": "Preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },
  "include": ["./src/**/*", "./tests/**/*", "esbuild-env.d.ts"]
}
